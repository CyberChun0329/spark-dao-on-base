BASE_RPC_URL=http://127.0.0.1:8545
BASE_CHAIN=base-sepolia

# Deployment authority and operating roles. Use trusted deployment keys/accounts.
DAO_AUTHORITY=0x0000000000000000000000000000000000000000
DAO_COORDINATOR=0x0000000000000000000000000000000000000000
DAO_TREASURY=0x0000000000000000000000000000000000000000
STABLE_ASSET=0x0000000000000000000000000000000000000000

# Full teaching deployments normally use the same registry address for both
# RESEARCH_REGISTRY and TEACHING_REGISTRY because TeachingRegistry inherits
# the research surface.
RESEARCH_REGISTRY=0x0000000000000000000000000000000000000000
TEACHING_REGISTRY=0x0000000000000000000000000000000000000000

# Required for client-side teaching reward preview and claim helpers.
TEACHING_REWARD_DISTRIBUTOR=0x0000000000000000000000000000000000000000
RESEARCH_POSITION_TOKEN=0x0000000000000000000000000000000000000000
TEACHING_NFT_TOKEN=0x0000000000000000000000000000000000000000

REWARD_UNLOCK_SECONDS=7776000
BUYBACK_WAIT_SECONDS=2592000
RESEARCH_BASE_URI=ipfs://research-position/
TEACHING_BASE_URI=ipfs://teaching/

DEMO_AUTHORITY_PRIVATE_KEY=0x00
DEMO_COORDINATOR_PRIVATE_KEY=0x00
DEMO_CONTRIBUTOR_ONE_PRIVATE_KEY=0x00
DEMO_CONTRIBUTOR_TWO_PRIVATE_KEY=0x00
DEMO_TEACHER_PRIVATE_KEY=0x00
DEMO_CUSTOMER_PRIVATE_KEY=0x00
