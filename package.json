{
  "name": "spark-dao-on-base",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "forge build",
    "build:sizes": "forge build --sizes --skip script",
    "test": "forge test -vvv",
    "fmt": "forge fmt",
    "client:typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "check:reproducibility-config": "tsx client/scripts/checkReproducibilityConfig.ts",
    "check:registry-admin-state": "tsx client/scripts/checkRegistryAdminState.ts",
    "check:module-compatibility": "tsx client/scripts/checkModuleCompatibility.ts",
    "check:module-compatibility:example": "MODULE_COMPATIBILITY_VALIDATE_MANIFEST_ONLY=1 MODULE_COMPATIBILITY_MANIFEST=client/module-compatibility.example.json tsx client/scripts/checkModuleCompatibility.ts",
    "check:teaching-surface": "tsx client/scripts/checkTeachingSurface.ts",
    "check:calibration": "tsx client/scripts/checkCalibration.ts",
    "simulate:teaching-cost": "tsx client/scripts/simulateTeachingCost.ts",
    "client:inspect": "tsx client/scripts/inspect.ts",
    "deploy:tokens": "forge script script/DeployTokens.s.sol:DeployTokens --rpc-url $BASE_RPC_URL --broadcast",
    "deploy:registry": "forge script script/DeployRegistry.s.sol:DeployRegistry --rpc-url $BASE_RPC_URL --broadcast",
    "deploy:set-minters": "forge script script/SetTokenMinters.s.sol:SetTokenMinters --rpc-url $BASE_RPC_URL --broadcast",
    "demo:research": "forge script script/DemoResearch.s.sol:DemoResearch --rpc-url $BASE_RPC_URL --broadcast",
    "demo:teaching": "forge script script/DemoTeaching.s.sol:DemoTeaching --rpc-url $BASE_RPC_URL --broadcast"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "viem": "^2.38.2"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
